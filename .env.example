# Application
APP_ENV=development
APP_NAME=PreMan Demo API
API_PREFIX=/api/v1

# Authentication
# Replace this value outside local development.
JWT_SECRET=change-me-before-production-with-at-least-32-characters
JWT_ISSUER=preman-demo-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RESET_TOKEN_MINUTES=15

# Storage
STORAGE_BACKEND=memory
TABLE_NAME=preman-demo-api
AWS_REGION=us-west-2

# JSON mock catalog. Local writes go to this ignored runtime copy, initialized
# from app/data/mock_db.json. Hosted deployments set this to s3 in CloudFormation.
MOCK_STORAGE_BACKEND=file
MOCK_DATA_FILE=.mock-data/mock_db.json
MOCK_DATA_BUCKET=
MOCK_DATA_KEY=mock_db.json

# Browser clients (comma-separated)
CORS_ORIGINS=*

# Stable URL used by the live contract smoke test.
BASE_URL=http://127.0.0.1:8000
# URL advertised by the local OpenAPI document.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Deterministic hackathon account. Do not use these credentials in a real app.
DEMO_USER_EMAIL=demo@preman.live
DEMO_USER_PASSWORD=PremanDemo123!
EXPOSE_DEMO_TOKENS=true
